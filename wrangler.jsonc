{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kapex-blogs",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kapex-blogs-db","database_id": "c6cf9033-0d1f-4f73-8f1d-f7bb728320b8",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "kapex-assets","preview_bucket_name": "kapex-assets",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
